# STAGE 1: Build the Application
FROM node:18-alpine AS builder

WORKDIR /app
COPY dashboard/package*.json ./
RUN npm install

# Copy the Next.js source code
COPY dashboard ./

# Build the Next.js app (compiles React down to static HTML/JS/CSS)
RUN npm run build


# STAGE 2: Run the Production Application
FROM node:18-alpine AS runner

WORKDIR /app

# Set Node environment to production
ENV NODE_ENV production

# Next.js standalone output automatically copies production dependencies
# so we only copy the built assets from the 'builder' stage!

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

# Start the standalone Node server generated by Next.js
CMD ["node", "server.js"]
